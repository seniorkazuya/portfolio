# Copy to .env.local and fill in values. Next.js loads .env.local automatically.

# Resend (https://resend.com) — required to send contact form emails
RESEND_API_KEY=

# Cloudflare Turnstile — required in production (Vercel: set in Project → Settings → Environment Variables)
# Site key must be NEXT_PUBLIC_* so it is available in the browser.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE=
# Optional legacy name (same value as above) if your Vercel project already uses it:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=
# Optional legacy name for the secret:
# TURNSTILE_SECRET_KEY=

# Optional: full URL to your CV PDF (Drive, blob, etc.). If unset, uses /Nakamura-Kazuya-Resume.pdf from /public.
# NEXT_PUBLIC_RESUME_URL=
