# Copy to .env.local and fill in values. Next.js loads .env.local automatically.

# Resend (https://resend.com) — required to send contact form emails
RESEND_API_KEY=

# Cloudflare Turnstile — required in production only; dev uses test keys in code
CLOUDFLARE_TURNSTILE_SECRET=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE=
